{
  "name": "quarto-feedback",
  "displayName": "Quarto Feedback",
  "description": "Add shared, numbered feedback to Quarto code lines and type comments directly below each chunk.",
  "version": "0.1.1",
  "publisher": "vladissta",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:quartoFeedback.add"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quartoFeedback.add",
        "title": "%command.addFeedback%"
      }
    ],
    "keybindings": [
      {
        "command": "quartoFeedback.add",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && !editorReadonly && resourceExtname =~ /\\.qmd$/i"
      }
    ]
  },
  "scripts": {
    "check": "node --check core.js && node --check extension.js && node scripts/check-release.js",
    "test": "node --test test/*.test.js",
    "test:host": "node scripts/test-host.js",
    "vscode:prepublish": "npm run check && npm test",
    "package": "node -e \"require('node:fs').mkdirSync('dist', {recursive: true})\" && vsce package --no-dependencies --out dist/",
    "package:contents": "vsce ls --no-dependencies"
  },
  "author": {
    "name": "vladissta"
  },
  "license": "MIT",
  "keywords": [
    "quarto",
    "feedback",
    "code annotations",
    "teaching",
    "qmd"
  ],
  "icon": "media/icon.png",
  "l10n": "./l10n",
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vladissta/quarto-feedback.git"
  },
  "homepage": "https://github.com/vladissta/quarto-feedback#readme",
  "bugs": {
    "url": "https://github.com/vladissta/quarto-feedback/issues"
  }
}
